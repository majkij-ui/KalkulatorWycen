{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window. Read-only access to the old QuoteGen quote library (plan §5b); writing to its folder is denied.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "fs:default",
    {
      "identifier": "fs:allow-read",
      "allow": [
        {
          "path": "$APPDATA"
        },
        {
          "path": "$APPDATA/**"
        },
        {
          "path": "$DATA/com.michal.quotegen/quotes.json"
        }
      ]
    },
    {
      "identifier": "fs:allow-write",
      "allow": [
        {
          "path": "$APPDATA"
        },
        {
          "path": "$APPDATA/**"
        }
      ],
      "deny": [
        {
          "path": "$DATA/com.michal.quotegen"
        },
        {
          "path": "$DATA/com.michal.quotegen/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [
        {
          "path": "$APPDATA"
        },
        {
          "path": "$APPDATA/**"
        }
      ],
      "deny": [
        {
          "path": "$DATA/com.michal.quotegen"
        },
        {
          "path": "$DATA/com.michal.quotegen/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [
        {
          "path": "$APPDATA"
        },
        {
          "path": "$APPDATA/**"
        },
        {
          "path": "$DATA/com.michal.quotegen/quotes.json"
        }
      ]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [
        {
          "path": "$APPDATA"
        },
        {
          "path": "$APPDATA/**"
        },
        {
          "path": "$DATA/com.michal.quotegen/quotes.json"
        }
      ]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [
        {
          "path": "$APPDATA"
        },
        {
          "path": "$APPDATA/**"
        }
      ],
      "deny": [
        {
          "path": "$DATA/com.michal.quotegen"
        },
        {
          "path": "$DATA/com.michal.quotegen/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [
        {
          "path": "$DOWNLOAD/**"
        },
        {
          "path": "$HOME/**"
        }
      ],
      "deny": [
        {
          "path": "$DATA/com.michal.quotegen"
        },
        {
          "path": "$DATA/com.michal.quotegen/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [
        {
          "path": "$DOWNLOAD/**"
        },
        {
          "path": "$HOME/**"
        }
      ]
    },
    "dialog:allow-save"
  ]
}
